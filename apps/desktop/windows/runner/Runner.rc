            VALUE "LegalCopyright", "Copyright (C) 2026 com.example. All rights reserved." "\0"
            VALUE "OriginalFilename", "quizsync_desktop.exe" "\0"
            VALUE "ProductName", "AI 双端搜题" "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
