//
// Version
//

// 版本号（M17 第 3 条：用户要求「版本号统一 1.0.0」）。
//
// 刻意不用 Flutter 生成的 `FLUTTER_VERSION`：它是 pubspec 的 `1.0.0+3`，
// 会把出包序号带进 exe 属性里（显示成 `1.0.0+3`）。产品版本就是 1.0.0。
//
// M18 第 1 条：**1.0.0 就是正式版**，前面的序号都只是内部出包序号，
// 界面（设置 → 关于）与 exe 属性里都不出现它。
#define VERSION_AS_NUMBER 1,0,0,0
#define VERSION_AS_STRING "1.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
