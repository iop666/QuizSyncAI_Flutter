<?xml version="1.0" encoding="utf-8"?>
<!-- M24（用户拍板）：App 数据**不出本机**。

     为什么 allowBackup="false" 还不够：Android 12（API 31）起，把应用数据搬走有两条路 ——
     云备份（Auto Backup，上传到用户的 Google Drive）与**换机直传（D2D transfer）**。
     `android:allowBackup="false"` 只关掉前者；D2D 由本文件（dataExtractionRules）控制，
     不写就是默认允许。两个域都显式排除，才真正等于「数据只留在这一台设备上」。

     代价（已与用户确认）：换机不再自动恢复历史与设置，需要重新配对 + 重新识别。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
